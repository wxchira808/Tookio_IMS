 "doctype": "Print Format",
 "font_size": 14,
 "html": "\n<div class=\"print-format investigation-print-format\">\n  <style>\n    .investigation-print-format {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n      color: #1f2937;\n      line-height: 1.6;\n    }\n    \n    .print-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 20px 0;\n      border-bottom: 3px solid #e5e7eb;\n      margin-bottom: 30px;\n    }\n    \n    .print-header .logo {\n      max-height: 50px;\n      max-width: 200px;\n    }\n    \n    .print-header .document-info {\n      text-align: right;\n    }\n    \n    .print-header .document-info h1 {\n      margin: 0 0 10px 0;\n      font-size: 24px;\n      font-weight: 600;\n      color: #1f2937;\n    }\n    \n    .print-header .document-info .investigation-id {\n      font-size: 18px;\n      font-weight: 500;\n      color: #6b7280;\n      margin-bottom: 5px;\n    }\n    \n    .status-badge {\n      display: inline-block;\n      padding: 4px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 500;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    \n    .status-pending { background-color: #fef3c7; color: #d97706; }\n    .status-in-progress { background-color: #dbeafe; color: #1e40af; }\n    .status-completed { background-color: #d1fae5; color: #059669; }\n    .status-on-hold { background-color: #f3f4f6; color: #374151; }\n    \n    .priority-badge {\n      display: inline-block;\n      padding: 4px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 500;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      margin-left: 10px;\n    }\n    \n    .priority-critical { background-color: #fee2e2; color: #dc2626; }\n    .priority-high { background-color: #fed7d7; color: #e53e3e; }\n    .priority-medium { background-color: #fef3c7; color: #d97706; }\n    .priority-low { background-color: #d1fae5; color: #059669; }\n    \n    .print-section {\n      margin-bottom: 30px;\n      page-break-inside: avoid;\n    }\n    \n    .print-section h2 {\n      font-size: 18px;\n      font-weight: 600;\n      margin: 0 0 15px 0;\n      padding-bottom: 8px;\n      border-bottom: 2px solid #e5e7eb;\n      color: #1f2937;\n    }\n    \n    .field-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n      gap: 20px;\n      margin-bottom: 20px;\n    }\n    \n    .field-item {\n      margin-bottom: 15px;\n    }\n    \n    .field-label {\n      font-weight: 600;\n      color: #6b7280;\n      font-size: 12px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      margin-bottom: 5px;\n    }\n    \n    .field-value {\n      color: #1f2937;\n      font-size: 14px;\n      min-height: 20px;\n    }\n    \n    .field-value.large {\n      font-size: 16px;\n      font-weight: 500;\n    }\n    \n    .description-box {\n      background-color: #f9fafb;\n      border: 1px solid #e5e7eb;\n      border-radius: 8px;\n      padding: 20px;\n      margin: 20px 0;\n    }\n    \n    .evidence-table,\n    .action-items-table,\n    .timeline-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 15px;\n    }\n    \n    .evidence-table th,\n    .evidence-table td,\n    .action-items-table th,\n    .action-items-table td,\n    .timeline-table th,\n    .timeline-table td {\n      border: 1px solid #e5e7eb;\n      padding: 12px;\n      text-align: left;\n      font-size: 13px;\n    }\n    \n    .evidence-table th,\n    .action-items-table th,\n    .timeline-table th {\n      background-color: #f9fafb;\n      font-weight: 600;\n      color: #374151;\n    }\n    \n    .print-footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      border-top: 1px solid #e5e7eb;\n      text-align: center;\n      color: #6b7280;\n      font-size: 12px;\n    }\n    \n    .no-data {\n      color: #9ca3af;\n      font-style: italic;\n    }\n    \n    .progress-section {\n      background-color: #f9fafb;\n      border-radius: 8px;\n      padding: 20px;\n      margin: 20px 0;\n    }\n    \n    .progress-item {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: 10px;\n      padding: 10px;\n      background-color: white;\n      border-radius: 6px;\n    }\n    \n    .progress-item:last-child {\n      margin-bottom: 0;\n    }\n    \n    .progress-label {\n      font-weight: 500;\n      color: #1f2937;\n    }\n    \n    .progress-status {\n      font-size: 12px;\n      padding: 3px 8px;\n      border-radius: 12px;\n    }\n    \n    .progress-completed {\n      background-color: #d1fae5;\n      color: #059669;\n    }\n    \n    .progress-pending {\n      background-color: #fef3c7;\n      color: #d97706;\n    }\n  </style>\n\n  <!-- Header -->\n  <div class=\"print-header\">\n    <div class=\"company-info\">\n      <img src=\"{{ company_logo }}\" alt=\"Company Logo\" class=\"logo\">\n    </div>\n    <div class=\"document-info\">\n      <h1>Investigation Report</h1>\n      <div class=\"investigation-id\">{{ doc.name }}</div>\n      <div>\n        <span class=\"status-badge status-{{ (doc.investigation_status or '').lower().replace(' ', '-') }}\">\n          {{ doc.investigation_status or 'Pending' }}\n        </span>\n        {% if doc.priority %}\n        <span class=\"priority-badge priority-{{ doc.priority.lower() }}\">\n          {{ doc.priority }}\n        </span>\n        {% endif %}\n      </div>\n    </div>\n  </div>\n\n  <!-- Basic Information -->\n  <div class=\"print-section\">\n    <h2>Investigation Summary</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Investigation Title</div>\n        <div class=\"field-value large\">{{ doc.investigation_title or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Related Incident</div>\n        <div class=\"field-value\">{{ doc.incident or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Investigation Type</div>\n        <div class=\"field-value\">{{ doc.investigation_type or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Lead Investigator</div>\n        <div class=\"field-value\">{{ doc.lead_investigator or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Assigned Team</div>\n        <div class=\"field-value\">{{ doc.investigation_team or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Investigation Scope</div>\n        <div class=\"field-value\">{{ doc.investigation_scope or '-' }}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Timeline Information -->\n  <div class=\"print-section\">\n    <h2>Investigation Timeline</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Start Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.start_date, {\"fieldtype\": \"Date\"}) or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Target Completion Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.target_completion_date, {\"fieldtype\": \"Date\"}) or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Actual Completion Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.actual_completion_date, {\"fieldtype\": \"Date\"}) or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Total Days</div>\n        <div class=\"field-value\">\n          {% if doc.start_date and doc.actual_completion_date %}\n            {{ frappe.utils.date_diff(doc.actual_completion_date, doc.start_date) }} days\n          {% elif doc.start_date %}\n            {{ frappe.utils.date_diff(frappe.utils.today(), doc.start_date) }} days (ongoing)\n          {% else %}\n            -\n          {% endif %}\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Root Cause Analysis -->\n  <div class=\"print-section\">\n    <h2>Root Cause Analysis</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Root Cause Category</div>\n        <div class=\"field-value\">{{ doc.root_cause_category or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Analysis Method</div>\n        <div class=\"field-value\">{{ doc.analysis_method or '-' }}</div>\n      </div>\n    </div>\n    \n    {% if doc.root_cause_description %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Root Cause Description</div>\n      <div class=\"field-value\">{{ doc.root_cause_description|safe }}</div>\n    </div>\n    {% endif %}\n    \n    {% if doc.contributing_factors %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Contributing Factors</div>\n      <div class=\"field-value\">{{ doc.contributing_factors|safe }}</div>\n    </div>\n    {% endif %}\n  </div>\n\n  <!-- Investigation Findings -->\n  {% if doc.investigation_findings %}\n  <div class=\"print-section\">\n    <h2>Investigation Findings</h2>\n    <div class=\"description-box\">\n      <div class=\"field-value\">{{ doc.investigation_findings|safe }}</div>\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Recommendations -->\n  {% if doc.recommendations %}\n  <div class=\"print-section\">\n    <h2>Recommendations</h2>\n    <div class=\"description-box\">\n      <div class=\"field-value\">{{ doc.recommendations|safe }}</div>\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Lessons Learned -->\n  {% if doc.lessons_learned %}\n  <div class=\"print-section\">\n    <h2>Lessons Learned</h2>\n    <div class=\"description-box\">\n      <div class=\"field-value\">{{ doc.lessons_learned|safe }}</div>\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Footer -->\n  <div class=\"print-footer\">\n    <p>This investigation report was generated on {{ frappe.format(frappe.utils.now(), {\"fieldtype\": \"Datetime\"}) }}</p>\n    <p>Report prepared by {{ doc.lead_investigator or frappe.session.user }}</p>\n    {% if doc.investigation_status == 'Completed' %}\n    <p><strong>Investigation Status: COMPLETED</strong></p>\n    {% endif %}\n  </div>\n</div>\n",
