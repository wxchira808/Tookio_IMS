{
 "align_labels_right": 0,
 "creation": "2025-09-22 10:00:00.000000",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "AI Incident Summary",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"ai-summary-print-format\">\n    <style>\n        .ai-summary-print-format {\n            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;\n            color: #333;\n            line-height: 1.6;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n        .header {\n            border-bottom: 3px solid #2490ef;\n            padding-bottom: 20px;\n            margin-bottom: 30px;\n            text-align: center;\n        }\n        .header h1 {\n            color: #2490ef;\n            font-size: 28px;\n            margin: 0;\n            font-weight: 600;\n        }\n        .header .subtitle {\n            color: #666;\n            font-size: 14px;\n            margin-top: 5px;\n        }\n        .incident-info {\n            background: #f8f9fa;\n            padding: 15px;\n            border-radius: 8px;\n            margin-bottom: 25px;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 15px;\n        }\n        .incident-info .field {\n            display: flex;\n            flex-direction: column;\n        }\n        .incident-info .field-label {\n            font-weight: 600;\n            color: #495057;\n            font-size: 12px;\n            text-transform: uppercase;\n            margin-bottom: 3px;\n        }\n        .incident-info .field-value {\n            font-size: 14px;\n            color: #333;\n        }\n        .summary-section {\n            margin-bottom: 25px;\n            page-break-inside: avoid;\n        }\n        .summary-section h3 {\n            color: #2490ef;\n            font-size: 18px;\n            margin-bottom: 10px;\n            border-bottom: 1px solid #dee2e6;\n            padding-bottom: 5px;\n        }\n        .summary-content {\n            padding-left: 10px;\n        }\n        .findings-list, .recommendations-list {\n            padding-left: 20px;\n        }\n        .findings-list li, .recommendations-list li {\n            margin-bottom: 8px;\n        }\n        .metadata {\n            margin-top: 40px;\n            padding-top: 20px;\n            border-top: 1px solid #dee2e6;\n            font-size: 12px;\n            color: #666;\n            text-align: center;\n        }\n        .ai-badge {\n            display: inline-block;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            color: white;\n            padding: 4px 8px;\n            border-radius: 12px;\n            font-size: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            margin-left: 10px;\n        }\n        @media print {\n            .ai-summary-print-format {\n                max-width: none;\n                margin: 0;\n            }\n            .header {\n                border-bottom: 2px solid #000;\n            }\n            .header h1 {\n                color: #000;\n            }\n            .summary-section h3 {\n                color: #000;\n            }\n        }\n    </style>\n    \n    <div class=\"header\">\n        <h1>AI-Generated Incident Summary</h1>\n        <div class=\"subtitle\">Automated Analysis & Recommendations<span class=\"ai-badge\">AI Powered</span></div>\n    </div>\n    \n    <div class=\"incident-info\">\n        <div class=\"field\">\n            <div class=\"field-label\">Incident ID</div>\n            <div class=\"field-value\">{{ doc.incident }}</div>\n        </div>\n        <div class=\"field\">\n            <div class=\"field-label\">Summary ID</div>\n            <div class=\"field-value\">{{ doc.name }}</div>\n        </div>\n        <div class=\"field\">\n            <div class=\"field-label\">Generated On</div>\n            <div class=\"field-value\">{{ frappe.utils.format_datetime(doc.generated_on) }}</div>\n        </div>\n        <div class=\"field\">\n            <div class=\"field-label\">AI Model</div>\n            <div class=\"field-value\">{{ doc.model_used or \"GPT-3.5 Turbo\" }}</div>\n        </div>\n    </div>\n    \n    {% if doc.executive_summary %}\n    <div class=\"summary-section\">\n        <h3>Executive Summary</h3>\n        <div class=\"summary-content\">\n            <p>{{ doc.executive_summary }}</p>\n        </div>\n    </div>\n    {% endif %}\n    \n    {% if doc.key_findings %}\n    <div class=\"summary-section\">\n        <h3>Key Findings & Impact Assessment</h3>\n        <div class=\"summary-content\">\n            {{ doc.key_findings|replace(\"•\", \"<li>\")|replace(\"\\n\", \"</li>\\n\")|safe }}\n        </div>\n    </div>\n    {% endif %}\n    \n    {% if doc.recommendations %}\n    <div class=\"summary-section\">\n        <h3>Recommendations & Next Steps</h3>\n        <div class=\"summary-content\">\n            {{ doc.recommendations|replace(\"•\", \"<li>\")|replace(\"\\n\", \"</li>\\n\")|safe }}\n        </div>\n    </div>\n    {% endif %}\n    \n    {% if doc.risk_assessment %}\n    <div class=\"summary-section\">\n        <h3>Risk Assessment</h3>\n        <div class=\"summary-content\">\n            <p>{{ doc.risk_assessment }}</p>\n        </div>\n    </div>\n    {% endif %}\n    \n    {% if doc.summary_content %}\n    <div class=\"summary-section\">\n        <h3>Complete Analysis</h3>\n        <div class=\"summary-content\">\n            {{ doc.summary_content|safe }}\n        </div>\n    </div>\n    {% endif %}\n    \n    <div class=\"metadata\">\n        <p><strong>Document Metadata:</strong></p>\n        <p>Generated: {{ frappe.utils.format_datetime(doc.generated_on) }} | \n           Model: {{ doc.model_used or \"GPT-3.5\" }} | \n           {% if doc.generation_time %}Processing Time: {{ \"%.1f\"|format(doc.generation_time) }}s{% endif %}\n           {% if doc.tokens_used %} | Tokens: {{ doc.tokens_used }}{% endif %}</p>\n        <p style=\"margin-top: 15px; font-style: italic;\">This summary was generated using artificial intelligence and should be reviewed by qualified personnel before making critical decisions.</p>\n    </div>\n</div>",
 "idx": 1,
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
 "margin_top": 15.0,
 "module": "Incident Management System",
 "name": "AI Summary Professional",
 "owner": "Administrator",
 "page_number": "Hide",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "show_section_headings": 0,
 "standard": "No"
}
