{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-09-20 00:53:58.048108",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Incident",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .incident-print-format {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n      color: #1f2937;\n      line-height: 1.6;\n    }\n    \n    .print-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 20px 0;\n      border-bottom: 3px solid #e5e7eb;\n      margin-bottom: 30px;\n    }\n    \n    .print-header .logo {\n      max-height: 50px;\n      max-width: 200px;\n    }\n    \n    .print-header .document-info {\n      text-align: right;\n    }\n    \n    .print-header .document-info h1 {\n      margin: 0 0 10px 0;\n      font-size: 24px;\n      font-weight: 600;\n      color: #1f2937;\n    }\n    \n    .print-header .document-info .incident-id {\n      font-size: 18px;\n      font-weight: 500;\n      color: #6b7280;\n      margin-bottom: 5px;\n    }\n    \n    .status-badge {\n      display: inline-block;\n      padding: 4px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 500;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    \n    .status-open { background-color: #dbeafe; color: #1e40af; }\n    .status-in-progress { background-color: #fef3c7; color: #d97706; }\n    .status-investigating { background-color: #e0e7ff; color: #6366f1; }\n    .status-resolved { background-color: #d1fae5; color: #059669; }\n    .status-closed { background-color: #f3f4f6; color: #374151; }\n    \n    .severity-badge {\n      display: inline-block;\n      padding: 4px 12px;\n      border-radius: 20px;\n      font-size: 12px;\n      font-weight: 500;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      margin-left: 10px;\n    }\n    \n    .severity-critical { background-color: #fee2e2; color: #dc2626; }\n    .severity-high { background-color: #fed7d7; color: #e53e3e; }\n    .severity-medium { background-color: #fef3c7; color: #d97706; }\n    .severity-low { background-color: #d1fae5; color: #059669; }\n    \n    .print-section {\n      margin-bottom: 30px;\n      page-break-inside: avoid;\n    }\n    \n    .print-section h2 {\n      font-size: 18px;\n      font-weight: 600;\n      margin: 0 0 15px 0;\n      padding-bottom: 8px;\n      border-bottom: 2px solid #e5e7eb;\n      color: #1f2937;\n    }\n    \n    .field-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n      gap: 20px;\n      margin-bottom: 20px;\n    }\n    \n    .field-item {\n      margin-bottom: 15px;\n    }\n    \n    .field-label {\n      font-weight: 600;\n      color: #6b7280;\n      font-size: 12px;\n      text-transform: uppercase;\n      letter-spacing: 0.5px;\n      margin-bottom: 5px;\n    }\n    \n    .field-value {\n      color: #1f2937;\n      font-size: 14px;\n      min-height: 20px;\n    }\n    \n    .field-value.large {\n      font-size: 16px;\n      font-weight: 500;\n    }\n    \n    .description-box {\n      background-color: #f9fafb;\n      border: 1px solid #e5e7eb;\n      border-radius: 8px;\n      padding: 20px;\n      margin: 20px 0;\n    }\n    \n    .timeline-container {\n      background-color: #f9fafb;\n      border-radius: 8px;\n      padding: 20px;\n    }\n    \n    .timeline-item {\n      display: flex;\n      margin-bottom: 15px;\n      padding-bottom: 15px;\n      border-bottom: 1px solid #e5e7eb;\n    }\n    \n    .timeline-item:last-child {\n      border-bottom: none;\n      margin-bottom: 0;\n      padding-bottom: 0;\n    }\n    \n    .timeline-date {\n      font-weight: 500;\n      color: #6b7280;\n      font-size: 12px;\n      margin-right: 15px;\n      min-width: 140px;\n    }\n    \n    .timeline-content {\n      flex: 1;\n    }\n    \n    .timeline-event-type {\n      font-weight: 600;\n      color: #1f2937;\n      font-size: 13px;\n      margin-bottom: 3px;\n    }\n    \n    .timeline-description {\n      color: #6b7280;\n      font-size: 13px;\n    }\n    \n    .affected-parties-table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 15px;\n    }\n    \n    .affected-parties-table th,\n    .affected-parties-table td {\n      border: 1px solid #e5e7eb;\n      padding: 12px;\n      text-align: left;\n      font-size: 13px;\n    }\n    \n    .affected-parties-table th {\n      background-color: #f9fafb;\n      font-weight: 600;\n      color: #374151;\n    }\n    \n    .print-footer {\n      margin-top: 40px;\n      padding-top: 20px;\n      border-top: 1px solid #e5e7eb;\n      text-align: center;\n      color: #6b7280;\n      font-size: 12px;\n    }\n    \n    .no-data {\n      color: #9ca3af;\n      font-style: italic;\n    }\n  </style>\n\n  <!-- Header -->\n  <div class=\"print-header\">\n    <div class=\"company-info\">\n      <img src=\"{{ company_logo }}\" alt=\"Company Logo\" class=\"logo\">\n    </div>\n    <div class=\"document-info\">\n      <h1>Incident Report</h1>\n      <div class=\"incident-id\">{{ doc.name }}</div>\n      <div>\n        <span class=\"status-badge status-{{ (doc.status or '').lower().replace(' ', '-') }}\">\n          {{ doc.status or 'Draft' }}\n        </span>\n        {% if doc.severity %}\n        <span class=\"severity-badge severity-{{ doc.severity.lower() }}\">\n          {{ doc.severity }}\n        </span>\n        {% endif %}\n      </div>\n    </div>\n  </div>\n\n  <!-- Basic Information -->\n  <div class=\"print-section\">\n    <h2>Incident Summary</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Title</div>\n        <div class=\"field-value large\">{{ doc.title1 or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Incident Type</div>\n        <div class=\"field-value\">{{ doc.incident_type or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Priority</div>\n        <div class=\"field-value\">{{ doc.priority or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Department</div>\n        <div class=\"field-value\">{{ doc.department or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Category</div>\n        <div class=\"field-value\">{{ doc.incident_category or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Location</div>\n        <div class=\"field-value\">{{ doc.location or '-' }}</div>\n      </div>\n    </div>\n    \n    {% if doc.description %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Description</div>\n      <div class=\"field-value\">{{ doc.description|safe }}</div>\n    </div>\n    {% endif %}\n  </div>\n\n  <!-- Time Information -->\n  <div class=\"print-section\">\n    <h2>Timeline</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Incident Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.incident_date, {\"fieldtype\": \"Datetime\"}) or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Reported Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.reported_date, {\"fieldtype\": \"Datetime\"}) or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Due Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.due_date, {\"fieldtype\": \"Datetime\"}) or '-' }}</div>\n      </div>\n      {% if doc.closure_date %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Closure Date</div>\n        <div class=\"field-value\">{{ frappe.format(doc.closure_date, {\"fieldtype\": \"Date\"}) }}</div>\n      </div>\n      {% endif %}\n    </div>\n  </div>\n\n  <!-- Reporter Information -->\n  <div class=\"print-section\">\n    <h2>Reporter Information</h2>\n    <div class=\"field-grid\">\n      <div class=\"field-item\">\n        <div class=\"field-label\">Full Name</div>\n        <div class=\"field-value\">{{ doc.full_name or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Email</div>\n        <div class=\"field-value\">{{ doc.email or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Phone</div>\n        <div class=\"field-value\">{{ doc.phone_number or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Organization</div>\n        <div class=\"field-value\">{{ doc.organization or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Department</div>\n        <div class=\"field-value\">{{ doc.reporter_department or '-' }}</div>\n      </div>\n      <div class=\"field-item\">\n        <div class=\"field-label\">Employee ID</div>\n        <div class=\"field-value\">{{ doc.reporter_employee_id or '-' }}</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Assignment Information -->\n  {% if doc.assigned_responder or doc.escalated_to %}\n  <div class=\"print-section\">\n    <h2>Assignment & Escalation</h2>\n    <div class=\"field-grid\">\n      {% if doc.assigned_responder %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Assigned Responder</div>\n        <div class=\"field-value\">{{ doc.assigned_responder }}</div>\n      </div>\n      {% endif %}\n      {% if doc.escalation_level %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Escalation Level</div>\n        <div class=\"field-value\">{{ doc.escalation_level }}</div>\n      </div>\n      {% endif %}\n      {% if doc.escalated_to %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Escalated To</div>\n        <div class=\"field-value\">{{ doc.escalated_to }}</div>\n      </div>\n      {% endif %}\n      {% if doc.response_team %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Response Team</div>\n        <div class=\"field-value\">{{ doc.response_team }}</div>\n      </div>\n      {% endif %}\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Investigation Information -->\n  {% if doc.investigation_id or doc.root_cause_description %}\n  <div class=\"print-section\">\n    <h2>Investigation</h2>\n    {% if doc.investigation_id %}\n    <div class=\"field-item\">\n      <div class=\"field-label\">Investigation ID</div>\n      <div class=\"field-value\">{{ doc.investigation_id }}</div>\n    </div>\n    {% endif %}\n    {% if doc.root_cause_category %}\n    <div class=\"field-item\">\n      <div class=\"field-label\">Root Cause Category</div>\n      <div class=\"field-value\">{{ doc.root_cause_category }}</div>\n    </div>\n    {% endif %}\n    {% if doc.root_cause_description %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Root Cause Description</div>\n      <div class=\"field-value\">{{ doc.root_cause_description|safe }}</div>\n    </div>\n    {% endif %}\n    {% if doc.investigation_findings %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Investigation Findings</div>\n      <div class=\"field-value\">{{ doc.investigation_findings|safe }}</div>\n    </div>\n    {% endif %}\n    {% if doc.lessons_learned %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Lessons Learned</div>\n      <div class=\"field-value\">{{ doc.lessons_learned|safe }}</div>\n    </div>\n    {% endif %}\n  </div>\n  {% endif %}\n\n  <!-- Resolution Information -->\n  {% if doc.resolution_id or doc.resolution_summary %}\n  <div class=\"print-section\">\n    <h2>Resolution</h2>\n    {% if doc.resolution_id %}\n    <div class=\"field-item\">\n      <div class=\"field-label\">Resolution ID</div>\n      <div class=\"field-value\">{{ doc.resolution_id }}</div>\n    </div>\n    {% endif %}\n    {% if doc.resolution_summary %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Resolution Summary</div>\n      <div class=\"field-value\">{{ doc.resolution_summary|safe }}</div>\n    </div>\n    {% endif %}\n    {% if doc.corrective_actions %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Corrective Actions</div>\n      <div class=\"field-value\">{{ doc.corrective_actions|safe }}</div>\n    </div>\n    {% endif %}\n    {% if doc.preventive_actions %}\n    <div class=\"description-box\">\n      <div class=\"field-label\">Preventive Actions</div>\n      <div class=\"field-value\">{{ doc.preventive_actions|safe }}</div>\n    </div>\n    {% endif %}\n  </div>\n  {% endif %}\n\n  <!-- Affected Parties -->\n  {% if doc.affected_parties %}\n  <div class=\"print-section\">\n    <h2>Affected Parties</h2>\n    <table class=\"affected-parties-table\">\n      <thead>\n        <tr>\n          <th>Party Type</th>\n          <th>Party Name</th>\n          <th>Impact Level</th>\n          <th>Notification Sent</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for party in doc.affected_parties %}\n        <tr>\n          <td>{{ party.party_type or '-' }}</td>\n          <td>{{ party.party_name or '-' }}</td>\n          <td>{{ party.impact_level or '-' }}</td>\n          <td>{{ 'Yes' if party.notification_sent else 'No' }}</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n  </div>\n  {% endif %}\n\n  <!-- Timeline Events -->\n  {% if doc.incident_timeline %}\n  <div class=\"print-section\">\n    <h2>Event Timeline</h2>\n    <div class=\"timeline-container\">\n      {% for event in doc.incident_timeline %}\n      <div class=\"timeline-item\">\n        <div class=\"timeline-date\">\n          {{ frappe.format(event.timestamp, {\"fieldtype\": \"Datetime\"}) or '-' }}\n        </div>\n        <div class=\"timeline-content\">\n          <div class=\"timeline-event-type\">{{ event.event_type or 'Update' }}</div>\n          <div class=\"timeline-description\">{{ event.event_description or '-' }}</div>\n          {% if event.updated_by %}\n          <div class=\"timeline-description\">Updated by: {{ event.updated_by }}</div>\n          {% endif %}\n        </div>\n      </div>\n      {% endfor %}\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Immediate Actions Taken -->\n  {% if doc.immediate_action_taken %}\n  <div class=\"print-section\">\n    <h2>Immediate Actions Taken</h2>\n    <div class=\"description-box\">\n      <div class=\"field-value\">{{ doc.immediate_action_taken|safe }}</div>\n    </div>\n  </div>\n  {% endif %}\n\n  <!-- Additional Information -->\n  <div class=\"print-section\">\n    <h2>Additional Information</h2>\n    <div class=\"field-grid\">\n      {% if doc.injuries_involved %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Injuries Involved</div>\n        <div class=\"field-value\">{{ 'Yes' if doc.injuries_involved else 'No' }}</div>\n      </div>\n      {% endif %}\n      {% if doc.property_damage %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Property Damage</div>\n        <div class=\"field-value\">{{ 'Yes' if doc.property_damage else 'No' }}</div>\n      </div>\n      {% endif %}\n      {% if doc.witness_present %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Witnesses Present</div>\n        <div class=\"field-value\">{{ 'Yes' if doc.witness_present else 'No' }}</div>\n      </div>\n      {% endif %}\n      {% if doc.witness_contact %}\n      <div class=\"field-item\">\n        <div class=\"field-label\">Witness Contact</div>\n        <div class=\"field-value\">{{ doc.witness_contact }}</div>\n      </div>\n      {% endif %}\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div class=\"print-footer\">\n    <p>This incident report was generated on {{ frappe.format(frappe.utils.now(), {\"fieldtype\": \"Datetime\"}) }}</p>\n    <p>Document generated by {{ frappe.session.user }}</p>\n  </div>\n</div>\n",
